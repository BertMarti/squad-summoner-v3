{
  "name": "squad-summoner-v3",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:pages": "VITE_DEPLOY_TARGET=pages vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm --prefix server start",
    "setup": "node scripts/setup.mjs",
    "server:grupos": "npm --prefix server run grupos",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@google/genai": "^2.32.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "description": "Genera convocatorias épicas para tu escuadrón con IA (Gemini) y envíalas a WhatsApp",
  "license": "MIT",
  "author": "BertMarti",
  "overrides": {
    "js-beautify": {
      "nopt": "^9.0.0"
    },
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
