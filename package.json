  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:pages": "VITE_DEPLOY_TARGET=pages vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm --prefix server start",
    "setup": "node scripts/setup.mjs",
    "server:grupos": "npm --prefix server run grupos"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
