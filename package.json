    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.8.1",
    "npm-run-all2": "^7.0.2",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
