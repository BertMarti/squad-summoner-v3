# Lo más fácil: ejecuta «npm run setup» y crea el .env por ti.
# O copia este archivo a .env a mano (NUNCA subas el .env a git).

# --- Web (Vite) ---
# ⚠️ Lo que empieza por VITE_ se incrusta en el JavaScript compilado.
# Úsalo solo en tu equipo; para la web publicada pega la clave desde la propia app.
VITE_GOOGLE_API_KEY=
# Servidor de WhatsApp al que llama la web (por defecto http://localhost:3000)
VITE_SERVER_URL=http://localhost:3000
# Modelo de Gemini (por defecto gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-2.5-flash
# Token del servidor que la web envía en la cabecera Authorization (lo rellena «npm run setup»).
# Solo para la web en TU equipo: si sirves la web a otros, déjalo vacío y pega el token en ⚙️ CONFIGURAR API → Servidor.
VITE_SERVER_TOKEN=

# --- Servidor (server/, opcional: solo para «📲 ENVIAR AL GRUPO») ---
# ID del grupo de WhatsApp (formato 120363012345678901@g.us). «npm run server:grupos» te lo enseña y lo guarda.
WHATSAPP_GROUP_ID=
PORT=3000
# 127.0.0.1 = solo este equipo. 0.0.0.0 lo expone a tu red local (entonces SERVER_TOKEN es obligatorio).
HOST=127.0.0.1
# Token secreto que la web debe enviar (Authorization: Bearer). Lo genera «npm run setup»; mínimo 24 caracteres.
SERVER_TOKEN=
# Orígenes web permitidos (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ruta a Chromium/Chrome del sistema. Obligatoria en Raspberry Pi (sudo apt install chromium). La rellena «npm run setup».
CHROMIUM_PATH=
